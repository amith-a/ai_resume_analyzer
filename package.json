{
  "name": "ai-resume-analyzer",
  "version": "1.0.0",
  "description": "AI Resume Analyzer Backend Service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate:up": "node-pg-migrate up -j ts",
    "migrate:down": "node-pg-migrate down -j ts",
    "migrate:create": "node-pg-migrate create -j ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/ollama": "^1.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
